{
  "name": "magento2-mcp-server",
  "version": "1.1.0",
  "description": "A production-ready Model Context Protocol (MCP) server for Magento 2 integration with AI Agents",
  "type": "module",
  "main": "index.js",
  "author": "Pratik Mehta <pratik.social.media@gmail.com>",
  "license": "MIT",
  "keywords": [
    "mcp",
    "magento",
