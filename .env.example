# ==========================================
# Magento 2 MCP Server Configuration
# ==========================================

# --- Magento 2 API ---
# Base URL should end with /rest/V1
MAGENTO_BASE_URL=https://your-store.ddev.site/rest/V1
# Permanent Integration Access Token (System -> Integrations)
MAGENTO_TOKEN=your_access_token_here

# --- AI (Google Gemini) ---
# Get your key from console.gemini.google.com
GEMINI_API_KEY=your-gemini-key-here

# --- Notifications ---
# Primary email for alerts
ALERT_EMAIL=admin@your-store.com

# SMTP Settings (for Email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Slack Webhook (for Slack alerts)
SLACK_WEBHOOK_URL=

# External Webhook (for Order Events)
ALERT_WEBHOOK_URL=

# --- Fulfilment ---
# Endpoint for order automation fulfilment triggers
FULFILMENT_ENDPOINT=

# --- Server Settings ---
PORT=3000
NODE_ENV=production
