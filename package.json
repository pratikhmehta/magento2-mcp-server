{
  "name": "magento2-mcp-server",
  "version": "1.1.0",
  "description": "A production-ready Model Context Protocol (MCP) server for Magento 2 integration with AI Agents",
  "type": "module",
  "main": "index.js",
  "author": "Pratik Mehta <pratik.social.media@gmail.com>",
  "license": "MIT",
  "keywords": [
    "mcp",
    "magento",
    "magento2",
    "ai",
    "agents",
    "automation",
    "inventory",
    "ecommerce"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "smoke": "node scripts/smoke.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "scan:secrets": "npx --yes @secretlint/quick-start \"**/*\"",
    "scan:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.18.1",
    "axios-retry": "^4.5.0",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "minimatch": "^10.2.6",
    "nodemailer": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "axios-mock-adapter": "^2.1.0",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "nock": "^14.0.16"
  },
  "jest": {
    "testMatch": [
      "**/src/**/*.test.js"
    ]
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  }
}